# Supabase values used by browser code during the Vite build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase values used by TanStack Start server rendering and server functions.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Set this to a modern sb_secret_ key. It must never be exposed to browser code.
SUPABASE_SERVICE_ROLE_KEY=
